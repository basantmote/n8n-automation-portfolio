    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst subject = item.Subject || item.subject || '';\nconst from = item.From || item.from || '';\nconst body = (item.snippet || item.text || '').substring(0, 2000);\n\nconst prompt = `Extract invoice details from this email. Return ONLY valid JSON, no markdown.\n\nEmail subject: ${subject}\nEmail from: ${from}\nEmail body: ${body}\n\nReturn JSON in this exact structure:\n{\n  \"is_invoice\": true or false,\n  \"vendor_name\": \"company name or empty string\",\n  \"amount\": numeric value only or 0,\n  \"currency\": \"USD/EUR/NPR or empty string\",\n  \"invoice_date\": \"YYYY-MM-DD or empty string\",\n  \"confidence\": \"high/medium/low\"\n}`;\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.groq.com/openai/v1/chat/completions',\n  headers: {\n    'Authorization': 'Bearer YOUR_GROQ_API_KEY_HERE',\n    'Content-Type': 'application/json'\n  },\n  body: {\n    model: 'llama-3.3-70b-versatile',\n    messages: [{ role: 'user', content: prompt }],\n    temperature: 0.1,\n    response_format: { type: 'json_object' }\n  },\n  json: true\n});\n\nconst parsed = JSON.parse(response.choices[0].message.content);\n\nreturn {\n  json: {\n    is_invoice: parsed.is_invoice === true,\n    vendor_name: parsed.vendor_name || '',\n    amount: parsed.amount || 0,\n    currency: parsed.currency || '',\n    invoice_date: parsed.invoice_date || '',\n    confidence: parsed.confidence || 'low',\n    sender_email: from,\n    subject: subject,\n    received_at: new Date(parseInt(item.internalDate || Date.now())).toISOString(),\n    message_id: item.id || ''\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
