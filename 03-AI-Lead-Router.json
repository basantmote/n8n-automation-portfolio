    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst prompt = `Write a brief, warm reply to this inquiry. The customer is interested but not urgent.\n\nCustomer name: ${data.name}\nCustomer message: ${data.message}\nInquiry type: ${data.inquiry_type}\n\nWrite in a ${data.suggested_reply_tone || 'consultative'} tone. Include:\n1. Personal greeting using their name\n2. Acknowledge what they're interested in (1-2 sentences)\n3. Offer a discovery call link\n4. Friendly close\n\nKeep it under 120 words. Sign as \"Basant\" from \"Basant Automation Studio\".\n\nReturn ONLY the email body text, no subject line, no markdown formatting.`;\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.groq.com/openai/v1/chat/completions',\n  headers: {\n    'Authorization': 'Bearer YOUR_GROQ_API_KEY_HERE',\n    'Content-Type': 'application/json'\n  },\n  body: {\n    model: 'llama-3.3-70b-versatile',\n    messages: [{ role: 'user', content: prompt }],\n    temperature: 0.7\n  },\n  json: true\n});\n\nconst replyText = response.choices[0].message.content;\n\nreturn {\n  json: {\n    ...data,\n    reply_body: replyText,\n    calendly_url: 'https://calendly.com/your-link-here'\n  }\n};"
      },
