    {
      "parameters": {
        "jsCode": "const parsedText = $input.first().json.ParsedResults[0].ParsedText;\n\nconst payload = {\n  model: \"llama-3.3-70b-versatile\",\n  temperature: 0.1,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are an invoice data extractor. Extract structured data from invoice text and return ONLY valid JSON with no explanation or markdown.\"\n    },\n    {\n      role: \"user\",\n      content: `Extract these fields and return as JSON only:\\n- vendor_name\\n- invoice_number\\n- invoice_date\\n- due_date\\n- total_amount\\n- currency\\n- bill_to_name\\n- bill_to_email\\n\\nInvoice text:\\n${parsedText}`\n    }\n  ]\n};\n\nreturn [{ json: { body: JSON.stringify(payload) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -496,
        -208
      ],
      "id": "fb33e05c-1ea3-4cbc-83b9-7f29be647c57",
      "name": "Prepare Groq Payload"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.first().json.choices[0].message.content;\n\n// Strip markdown code fences if present\nconst cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nconst invoice = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    vendor_name: invoice.vendor_name,\n    invoice_number: invoice.invoice_number,\n    invoice_date: invoice.invoice_date,\n    due_date: invoice.due_date,\n    total_amount: invoice.total_amount,\n    currency: invoice.currency,\n    bill_to_name: invoice.bill_to_name,\n    bill_to_email: invoice.bill_to_email,\n    processed_at: new Date().toISOString(),\n    source_file: \"invoice_\" + new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
