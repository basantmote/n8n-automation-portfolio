    {
      "parameters": {
        "jsCode": "// Stage 2: Enrich with Hunter.io (email finder + company data)\n// If you don't have Hunter.io key, this returns the existing email and skips enrichment\nconst lead = $input.first().json;\n\nconst HUNTER_API_KEY = 'YOUR_HUNTER_API_KEY_HERE';\n\nlet enriched = { ...lead };\n\ntry {\n  if (HUNTER_API_KEY !== 'YOUR_HUNTER_API_KEY_HERE' && lead.domain) {\n    // Domain search: get company info + email pattern\n    const domainRes = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `https://api.hunter.io/v2/domain-search?domain=${lead.domain}&api_key=${HUNTER_API_KEY}&limit=1`,\n      json: true\n    });\n\n    const data = domainRes.data || {};\n    enriched.company_industry = data.industry || '';\n    enriched.company_size = data.company_size || '';\n    enriched.email_pattern = data.pattern || '';\n    enriched.linkedin_url = data.linkedin || '';\n\n    // Use found email if original is missing\n    if (!enriched.email && data.emails && data.emails.length > 0) {\n      enriched.email = data.emails[0].value || '';\n    }\n  } else {\n    // No Hunter key — use whatever came from CSV\n    enriched.company_industry = lead.industry || 'home remodeling';\n    enriched.company_size = lead.employee_count || 'unknown';\n    enriched.email_pattern = '';\n    enriched.linkedin_url = '';\n  }\n} catch (err) {\n  enriched.enrichment_error = err.message;\n  enriched.company_industry = '';\n  enriched.company_size = '';\n}\n\nenriched.enriched_at = new Date().toISOString();\n\nreturn { json: enriched };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-224, 0],
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Enrich with Hunter.io"
    },
    {
      "parameters": {
        "jsCode": "// Stage 3: Scrape website content for AI analysis\nconst lead = $input.first().json;\n\nlet websiteText = '';\n\ntry {\n  const domain = lead.domain || '';\n  if (!domain) throw new Error('No domain provided');\n\n  const url = domain.startsWith('http') ? domain : `https://${domain}`;\n\n  // Fetch the homepage HTML\n  const response = await this.helpers.httpRequest({\n    method: 'GET',\n    url: url,\n    headers: {\n      'User-Agent': 'Mozilla/5.0 (compatible; LeadEnrichBot/1.0)'\n    },\n    timeout: 10000,\n    ignoreHttpStatusErrors: true\n  });\n\n  // Strip HTML tags and get plain text (max 2000 chars for AI)\n  const raw = typeof response === 'string' ? response : JSON.stringify(response);\n  websiteText = raw\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .substring(0, 2000);\n\n} catch (err) {\n  websiteText = `Could not fetch website: ${err.message}`;\n}\n\nreturn {\n  json: {\n    ...$input.first().json,\n    website_text: websiteText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-32, 0],
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Scrape Website"
    },
    {
      "parameters": {
        "jsCode": "// Stage 4: AI scoring — same Groq pattern as your Lead Router\nconst lead = $input.first().json;\n\nconst GROQ_API_KEY = 'YOUR_GROQ_API_KEY_HERE';\n\nconst prompt = `You are a lead scoring specialist for a home remodeling SaaS company.\nAnalyze this business and score them as a potential customer. Return ONLY valid JSON.\n\nCompany: ${lead.company_name}\nDomain: ${lead.domain}\nIndustry: ${lead.company_industry || 'unknown'}\nCompany size: ${lead.company_size || 'unknown'}\nLocation: ${lead.city || ''}, ${lead.state || ''}\nWebsite content (first 2000 chars):\n${lead.website_text || 'Not available'}\n\nScore this lead based on these criteria:\n1. Are they in home remodeling, renovation, contracting, or construction? (most important)\n2. Do they appear to be an active business with a real web presence?\n3. Do they seem to be a small-to-mid sized company (not a huge national chain)?\n4. Are there signs they could benefit from lead generation software?\n\nReturn JSON in this exact structure:\n{\n  \"score\": <number 1-10>,\n  \"qualified\": <true if score >= 7, else false>,\n  \"industry_match\": <\"strong\" | \"partial\" | \"none\">,\n  \"business_type\": <1-3 word description, e.g. \"kitchen remodeler\">,\n  \"key_signals\": [\"signal1\", \"signal2\", \"signal3\"],\n  \"disqualify_reason\": <\"\" if qualified, else one sentence why not>,\n  \"reasoning\": <one sentence summary>\n}`;\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.groq.com/openai/v1/chat/completions',\n  headers: {\n    'Authorization': `Bearer ${GROQ_API_KEY}`,\n    'Content-Type': 'application/json'\n  },\n  body: {\n    model: 'llama-3.3-70b-versatile',\n    messages: [{ role: 'user', content: prompt }],\n    temperature: 0.1,\n    response_format: { type: 'json_object' }\n  },\n  json: true\n});\n\nlet parsed;\ntry {\n  parsed = JSON.parse(response.choices[0].message.content);\n} catch (e) {\n  parsed = { score: 0, qualified: false, reasoning: 'Parse error', key_signals: [], disqualify_reason: 'AI parse failed' };\n}\n\nreturn {\n  json: {\n    ...lead,\n    ai_score: parsed.score || 0,\n    ai_qualified: parsed.qualified || false,\n    industry_match: parsed.industry_match || 'none',\n    business_type: parsed.business_type || '',\n    key_signals: (parsed.key_signals || []).join(', '),\n    disqualify_reason: parsed.disqualify_reason || '',\n    score_reasoning: parsed.reasoning || '',\n    scored_at: new Date().toISOString()\n  }\n};"
      },
