    {
      "parameters": {
        "jsCode": "// Read CSV binary and parse into lead objects\nconst binaryData = $input.first().binary?.data;\n\nlet csvText;\nif (binaryData) {\n  const buffer = await this.helpers.getBinaryDataBuffer($input.first(), 'data');\n  csvText = buffer.toString('utf-8');\n} else {\n  // Fallback: sample data for testing without a real CSV\n  csvText = `company_name,first_name,last_name,email,domain,phone,city,state\nABC Remodeling,John,Smith,john@abcremodeling.com,abcremodeling.com,555-1234,Denver,CO\nSunset Home Builders,Maria,Lopez,maria@sunsethb.com,sunsethb.com,555-5678,Austin,TX\nPeak Renovation Co,David,Chen,david@peakreno.com,peakreno.com,555-9012,Seattle,WA`;\n}\n\n// Parse CSV\nconst lines = csvText.trim().split('\\n');\nconst headers = lines[0].split(',').map(h => h.trim().replace(/\"/g, ''));\n\nconst leads = [];\nfor (let i = 1; i < lines.length; i++) {\n  if (!lines[i].trim()) continue;\n  const values = lines[i].split(',').map(v => v.trim().replace(/\"/g, ''));\n  const lead = {};\n  headers.forEach((h, idx) => { lead[h] = values[idx] || ''; });\n  leads.push({ json: lead });\n}\n\nreturn leads;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-608, 0],
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Parse CSV"
    },
    {
      "parameters": {
        "batchSize": 1,
