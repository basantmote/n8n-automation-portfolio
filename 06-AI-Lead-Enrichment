    {
      "parameters": {
        "jsCode": "// Stage 6: Push to Instantly API V2\nconst lead = $input.first().json;\n\nconst INSTANTLY_API_KEY = 'YOUR_INSTANTLY_API_KEY_HERE';\nconst CAMPAIGN_ID = 'YOUR_CAMPAIGN_ID_HERE';\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.instantly.ai/api/v2/leads/add',\n  headers: {\n    'Authorization': `Bearer ${INSTANTLY_API_KEY}`,\n    'Content-Type': 'application/json'\n  },\n  body: {\n    campaign_id: CAMPAIGN_ID,\n    leads: [\n      {\n        email: lead.email,\n        first_name: lead.first_name || '',\n        last_name: lead.last_name || '',\n        company_name: lead.company_name || '',\n        website: lead.domain ? `https://${lead.domain}` : '',\n        phone: lead.phone || '',\n        personalization: lead.email_intro || '',\n        custom_variables: {\n          ai_score: String(lead.ai_score || '0'),\n          business_type: lead.business_type || '',\n          industry_match: lead.industry_match || '',\n          key_signals: lead.key_signals || '',\n          subject_line: lead.subject_line || '',\n          city: lead.city || '',\n          state: lead.state || ''\n        }\n      }\n    ]\n  },\n  json: true,\n  ignoreHttpStatusErrors: true\n});\n\nconst success = !response.error && response.leads?.length > 0;\n\nreturn {\n  json: {\n    ...lead,\n    instantly_push_success: success,\n    instantly_response: JSON.stringify(response),\n    pushed_at: new Date().toISOString()\n  }\n};"
      },
